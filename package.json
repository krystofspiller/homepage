{
  "name": "homepage",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "tsx src/scripts/generate-blog-versions.ts && astro build",
    "test": "vitest",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "lint": "oxlint --type-aware --fix",
    "lint:ci": "oxlint --type-aware",
    "scripts:check-links": "tsx src/scripts/check-links.ts",
    "clean": "rm -rf dist .astro .cache .wrangler playwright-report test-results src/data/blog-versions",
    "clean:all": "pnpm clean && rm -rf node_modules",
    "knip": "knip"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/mdx": "^8.1.1",
    "@floating-ui/dom": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "alpinejs": "^3.17.5",
    "astro": "^7.4.2",
    "butteruptoasts": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.15.0",
    "nanostores": "^1.5.5",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@t3-oss/env-core": "^0.13.11",
    "@types/alpinejs": "^3.17.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.6.6",
    "dotenv": "^18.0.9",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "linkedom": "^0.18.14",
    "msw": "^3.0.3",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
