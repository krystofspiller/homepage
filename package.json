{
  "name": "homepage",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "tsx src/scripts/generate-blog-versions.ts && astro build",
    "test": "vitest",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "lint": "oxlint --type-aware --fix",
    "lint:ci": "oxlint --type-aware",
    "scripts:check-links": "tsx src/scripts/check-links.ts",
    "clean": "rm -rf dist .astro .cache .wrangler playwright-report test-results src/data/blog-versions",
    "clean:all": "pnpm clean && rm -rf node_modules",
    "knip": "knip"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^1.0.0",
    "@astrojs/mdx": "^7.0.3",
    "@floating-ui/dom": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "alpinejs": "^3.15.12",
    "astro": "^7.1.3",
    "butteruptoasts": "^2.0.1",
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.15.0",
    "nanostores": "^1.4.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@t3-oss/env-core": "^0.13.11",
    "@types/alpinejs": "^3.13.11",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jsdom": "^28.0.3",
    "@types/node": "24.13.2",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "knip": "^6.29.0",
    "linkedom": "^0.18.13",
    "msw": "^2.15.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
